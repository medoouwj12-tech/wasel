NODE_ENV=production
PORT=5000
TZ=Africa/Cairo
JWT_SECRET=
CORS_ORIGINS=
VITE_API_BASE=/api
# Set to true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
REQUIRE_STUDENT_APPROVAL=true
DATABASE_PATH=./data/wasel.sqlite

# Used once by `npm run bootstrap:admin` on a new production database.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=
