NODE_ENV=production
PORT=5000
APP_TIME_ZONE=Africa/Cairo
JWT_SECRET=
CORS_ORIGINS=
VITE_API_BASE=/api
# Set to true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
REQUIRE_STUDENT_APPROVAL=true
# Paste the Supabase Transaction Pooler URI from Project Settings > Database.
DATABASE_URL=
DB_POOL_MAX=1
# Optional. Set to "disable" only for local PostgreSQL without TLS.
DATABASE_SSL=verify-full

# Used once by `npm run bootstrap:admin` on a new production database.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=
